        "findings_sha256": "7855f26b75c8bd5b226e720800d1da009f2acf0fcbd5ed64a4a7ea61df458ba3",
        "conclusion": [
          "DiagnosticMet/DiagnosticNotMet are not operational Passed/Failed",
          "A known proxy violation establishes DiagnosticNotMet even when another proxy is missing; otherwise incomplete inputs remain Unknown",
